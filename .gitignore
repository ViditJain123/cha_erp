node_modules/
dist/
.env
.env.*
*.tsbuildinfo
.DS_Store
.vercel
.env*

# The customs corpus: ~1.3 GB of CBIC tariff volumes, notification PDFs and
# ICEGATE specification documents. Re-downloadable with
# `packages/core/scripts/fetch-corpus.py`, so it is not worth versioning.
# data/customs-corpus/index/ IS committed — that is the parsed, structured
# output the build consumes.
data/customs-corpus/tariff/
data/customs-corpus/notifications/
data/customs-corpus/icegate-specs/
data/customs-corpus/circulars/
data/customs-corpus/instructions/
data/customs-corpus/orders/
data/customs-corpus/regulations/
data/customs-corpus/rules/
# Page text extracted from the above by packages/library extract-corpus.
data/customs-corpus/text/

# The BDP Customs Tariff 2026-27 books: 162 MB of scanned PDFs, bought not
# fetched, so there is no re-download command. The parse in
# packages/core/src/masters/generated/tariff-book/ IS committed.
data/tariff-books/

# Must stay last: a later pattern wins, and `.env*` above would otherwise
# re-ignore this file. `vercel link` appends `.env*` on every run, so if this
# negation stops being the final line, move it back down here.
!.env.example
