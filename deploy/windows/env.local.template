# Production .env.local for the Windows worker box.
#
# Copy to the REPO ROOT (not this directory) as `.env.local`:
#   copy deploy\windows\env.local.template .env.local
#
# @checklist/config/load-env walks up from packages/config looking for
# .env.local, so the repo root is the only place it will be found.
#
# Then lock it down -- this file holds a full RLS bypass key:
#   icacls "C:\erp\checklist-app\.env.local" /inheritance:r /grant:r "SYSTEM:(R)" "Administrators:(R)"

# ---------------------------------------------------------------- Supabase --
# All three NEXT_PUBLIC_* vars are required even though the worker serves no
# browser: supabaseEnv() spreads publicEnv(), so serviceClient() refuses to
# build without them. NEXT_PUBLIC_APP_URL must be a valid URL.
NEXT_PUBLIC_SUPABASE_URL=https://ypgvlhzwjfaquxsxzous.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------- App --
# The production Vercel URL, NOT localhost. This lands in outgoing email links.
NEXT_PUBLIC_APP_URL=https://REPLACE-ME.vercel.app

# ------------------------------------------------- Microsoft Graph (Phase B) --
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Required by graphSchema as a URL even though the worker never serves the
# callback. Must match what is registered in the Azure AD app registration.
MS_REDIRECT_URI=https://REPLACE-ME.vercel.app/api/integrations/microsoft/callback

# Must match what Vercel has, since the web app obtains the token and this
# worker refreshes it. Set to `common` by your decision on 2026-08-18.
# (`organizations` = work/school only; `common` also admits personal accounts.)
MS_TENANT_ID=common

# MUST be byte-identical to the value in Vercel. The web app encrypts OAuth
# refresh tokens at connect time (api/integrations/microsoft/callback/route.ts)
# and this worker decrypts them on every poll (src/poll.ts). A mismatch means
# no mailbox can be read. Copy the existing key -- do not regenerate, that
# would orphan every mailbox already connected.
TOKEN_ENCRYPTION_KEY=

# `console` PRINTS outgoing Outlook mail instead of sending it. Your dev
# .env.local had console. In production this must be `graph` or the app looks
# healthy while no shipper ever receives a request.
GRAPH_TRANSPORT=graph

# ------------------------------------------------------------------ OpenAI --
# Required: the worker's ingest path calls triage.ts and scrutiny.ts.
OPENAI_API_KEY=

# ------------------------------------------------------------------ Worker --
# Distinguishes this box in claim_mail_connection's locked_by column and in the
# logs. Must be unique per running worker.
WORKER_INSTANCE_ID=win-office-1
WORKER_TICK_SECONDS=60
WORKER_MAILBOX_INTERVAL_SECONDS=300
LOG_LEVEL=info

# ------------------------------------------------------------------- Unused --
# Not read by the worker -- these belong to the web app only. Left commented so
# it is obvious they were considered rather than forgotten:
#   RESEND_API_KEY / MAIL_FROM / MAIL_TRANSPORT   (invites + password resets)
#   SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD        (one-off seeding script)
