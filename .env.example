# Copy to .env.local and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------- Supabase --
# `npx supabase start` prints these for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses row-level security. Server and worker only — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------- App --
NEXT_PUBLIC_APP_URL=http://localhost:3040

# ------------------------------------------------------------------- Email --
# Leave RESEND_API_KEY blank in development: the transport falls back to
# `console`, which prints the rendered email — temp password included — to
# stdout. That is how you read a new user's credentials locally.
# MAIL_TRANSPORT=console
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
MAIL_FROM="Acme ERP <onboarding@resend.dev>"

# ------------------------------------------------ Microsoft Graph (Phase B) --
# Optional until the Outlook watcher is built — Phase A runs without these.
# Azure AD app registration. Delegated scopes: Mail.Read, Mail.Send, offline_access, User.Read.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3040/api/integrations/microsoft/callback
# `organizations` = work/school accounts only. Personal Microsoft accounts have
# different Graph delta semantics, and this is a B2B product.
MS_TENANT_ID=organizations

# `console` prints outgoing Outlook mail instead of sending it, so the shipper
# request loop can be driven without a live mailbox.
# GRAPH_TRANSPORT=console

# Encrypts stored OAuth refresh tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------- Worker (Phase B) --
# WORKER_TICK_SECONDS=60
# WORKER_MAILBOX_INTERVAL_SECONDS=300
# WORKER_INSTANCE_ID=local
# LOG_LEVEL=info

# ------------------------------------------------------------------ OpenAI --
OPENAI_API_KEY=

# ------------------------------------- Legacy checklist generator (optional) --
# Defaults to <cwd>/data/masters and <cwd>/data/library when unset.
# MASTERS_DIR=
# LIBRARY_DIR=
